# ============================================================
# JerAI: kunci API untuk api/chat.js
# Salin file ini menjadi .env (untuk `vercel dev`), ATAU isi di
# Vercel: Project > Settings > Environment Variables.
# Jangan pernah commit file .env berisi kunci asli.
# Cukup isi penyedia yang kamu punya; yang kosong otomatis nonaktif.
# ============================================================

# Claude (Anthropic)    https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ChatGPT (OpenAI)      https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Gemini (Google)       https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek              https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Blackbox AI           https://www.blackbox.ai/settings/api-keys
BLACKBOX_API_KEY=
BLACKBOX_MODEL=blackboxai/openai/gpt-5.5

# Grok (xAI)            https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Catatan: nama model sering berganti. Jika muncul error "model not found",
# cek daftar model terbaru di dokumentasi penyedia lalu ubah nilai *_MODEL di atas.
